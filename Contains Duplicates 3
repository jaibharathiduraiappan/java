class Solution {
    public boolean containsNearbyAlmostDuplicate(int[] nums, int indexDiff, int valueDiff) {
        if (valueDiff < 0) return false;
        
        TreeSet<Long> window = new TreeSet<>();
        for (int i = 0; i < nums.length; i++) {
            if (i > indexDiff) {
                window.remove((long) nums[i - indexDiff - 1]);
            }
            
            Long floor = window.floor((long) nums[i]);
            if (floor != null && nums[i] - floor <= valueDiff) {
                return true;
            }
            
            Long ceiling = window.ceiling((long) nums[i]);
            if (ceiling != null && ceiling - nums[i] <= valueDiff) {
                return true;
            }
            
            window.add((long) nums[i]);
        }
        return false;
    }
}
